# PostgreSQL Environment Variables for ASPNET PLAYGROUND
# Fill in your database connection parameters or reference Railway PostgreSQL plugin variables

PGHOST=localhost
PGPORT=5432
PGDATABASE=persondb
PGUSER=postgres
PGPASSWORD=your_password_here

# SSL Configuration (Prefer for localhost, Require for Railway / Cloud)
PGSSLMODE=Require
PGTRUSTSERVERCERTIFICATE=true

# Redis Configuration for Link Sharing (/link)
# Option 1: URL format (used by Railway REDIS_URL / REDIS_PRIVATE_URL)
REDIS_URL=redis://localhost:6379

# Option 2: Individual variables (Railway Redis plugin)
# REDISHOST=localhost
# REDISPORT=6379
# REDISUSER=default
# REDISPASSWORD=your_redis_password_here
