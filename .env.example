# PostgreSQL Environment Variables for ASPNET PLAYGROUND
# Fill in your database connection parameters or reference Railway PostgreSQL plugin variables

PGHOST=localhost
PGPORT=5432
PGDATABASE=persondb
PGUSER=postgres
PGPASSWORD=your_password_here

# SSL Configuration (Prefer for localhost, Require for Railway / Cloud)
PGSSLMODE=Require
PGTRUSTSERVERCERTIFICATE=true
