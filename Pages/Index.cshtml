@page
@model WebApplicationASP01.Pages.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "PŘEHLED";
}

<div class="playground-home">
    <!-- Brutalist Hero Section -->
    <section class="playground-hero">
        <div class="hero-stamp-wrapper">
            <span class="brutalist-stamp stamp-yellow">★ VERSION 10.0</span>
            <span class="brutalist-stamp stamp-black">HIGH VOLTAGE</span>
            <span class="brutalist-stamp stamp-yellow">PRODUCTION READY</span>
        </div>
        <h1 class="hero-title">
            ASPNET<br /><span class="hero-title-highlight">PLAYGROUND</span>
        </h1>
        <p class="hero-subtitle">
            Tři nezávislé fullstack moduly v jedné aplikaci. Žádné zbytečné kudrlinky. Čistý výkon .NET 10, SignalR WebSockets a PostgreSQL.
        </p>
    </section>

    <!-- Split Hub Grid (3 Modules) -->
    <section class="split-hub-grid">
        <!-- Card 1: Real-Time SignalR Chat -->
        <article class="hub-card hub-card-chat">
            <div class="card-header-bar">
                <span class="card-tag">MODULE_01 // REALTIME</span>
                <span class="card-status-badge">● LIVE_FEED</span>
            </div>

            <div class="card-content">
                <div class="card-title-row">
                    <span class="card-emoji-box">⚡</span>
                    <h2>SIGNALR CHAT</h2>
                </div>
                <p class="card-desc">
                    Globální real-time chat napříč klienty přes WebSockets bez reloadu. Okamžitá latence pod 1ms, in-memory historie a audio syntezátor.
                </p>

                <div class="brutalist-feature-box">
                    <div class="feature-row">
                        <span class="feature-bullet">[x]</span>
                        <span><strong>WebSockets Core:</strong> Obousměrný duplexní stream</span>
                    </div>
                    <div class="feature-row">
                        <span class="feature-bullet">[x]</span>
                        <span><strong>Live Presence:</strong> Přesné počítadlo online připojených</span>
                    </div>
                    <div class="feature-row">
                        <span class="feature-bullet">[x]</span>
                        <span><strong>Web Audio FX:</strong> Syntetizované zvuky zpráv</span>
                    </div>
                    <div class="feature-row">
                        <span class="feature-bullet">[x]</span>
                        <span><strong>Auto Reconnect:</strong> Automatické obnovení spojení</span>
                    </div>
                </div>
            </div>

            <div class="card-bottom">
                <a href="/chat" class="btn-brutalist btn-brutalist-yellow">
                    <span>VSTOUPIT DO CHATU</span>
                    <span class="btn-arrow">[➔]</span>
                </a>
            </div>
        </article>

        <!-- Card 2: Notes CRUD & REST API -->
        <article class="hub-card hub-card-crud">
            <div class="card-header-bar">
                <span class="card-tag">MODULE_02 // DATABASE</span>
                <span class="card-status-badge">● POSTGRES_OK</span>
            </div>

            <div class="card-content">
                <div class="card-title-row">
                    <span class="card-emoji-box">📝</span>
                    <h2>NOTES APP</h2>
                </div>
                <p class="card-desc">
                    Plnohodnotný asynchronní CRUD pro poznámky. Napojeno na PostgreSQL (EF Core) se SignalR real-time synchronizací a fulltextovým vyhledáváním (ILIKE).
                </p>

                <div class="brutalist-feature-box">
                    <div class="feature-row">
                        <span class="feature-bullet">[x]</span>
                        <span><strong>PostgreSQL & EF Core:</strong> Repository pattern</span>
                    </div>
                    <div class="feature-row">
                        <span class="feature-bullet">[x]</span>
                        <span><strong>REST API:</strong> Endpointy <code>/api/notes</code></span>
                    </div>
                    <div class="feature-row">
                        <span class="feature-bullet">[x]</span>
                        <span><strong>SignalR Sync:</strong> Auto-refresh UI po uložení</span>
                    </div>
                    <div class="feature-row">
                        <span class="feature-bullet">[x]</span>
                        <span><strong>Vyhledávání:</strong> ILIKE filtr přes databázi</span>
                    </div>
                </div>
            </div>

            <div class="card-bottom card-bottom-split">
                <a href="/notes" class="btn-brutalist btn-brutalist-yellow">
                    <span>OTEVŘÍT POZNÁMKY</span>
                    <span class="btn-arrow">[➔]</span>
                </a>
                <a href="/swagger" target="_blank" class="btn-brutalist" title="Swagger OpenAPI">
                    <span>SWAGGER [↗]</span>
                </a>
            </div>
        </article>

        <!-- Card 3: Cross-Device Link Share -->
        <article class="hub-card hub-card-link">
            <div class="card-header-bar">
                <span class="card-tag">MODULE_03 // CACHE_SYNC</span>
                <span class="card-status-badge">● LINK_READY</span>
            </div>

            <div class="card-content">
                <div class="card-title-row">
                    <span class="card-emoji-box">🔗</span>
                    <h2>LINK SHARE</h2>
                </div>
                <p class="card-desc">
                    Bleskové sdílení textů a URL odkazů mezi počítačem, mobilem a tabletem. Ukládání do sdíleného seznamu odkazů s automatickou expirací 7 dní.
                </p>

                <div class="brutalist-feature-box">
                    <div class="feature-row">
                        <span class="feature-bullet">[x]</span>
                        <span><strong>Link Storage:</strong> <code>shared:links</code></span>
                    </div>
                    <div class="feature-row">
                        <span class="feature-bullet">[x]</span>
                        <span><strong>Auto Limit &amp; TTL:</strong> Posledních 50 položek, TTL 7 dní</span>
                    </div>
                    <div class="feature-row">
                        <span class="feature-bullet">[x]</span>
                        <span><strong>Auto URL detekce:</strong> Klikatelné odkazy + 1-klik kopírování</span>
                    </div>
                    <div class="feature-row">
                        <span class="feature-bullet">[x]</span>
                        <span><strong>Graceful Fallback:</strong> In-memory záložní režim</span>
                    </div>
                </div>
            </div>

            <div class="card-bottom card-bottom-split">
                <a href="/link" class="btn-brutalist btn-brutalist-yellow">
                    <span>OTEVŘÍT LINK SHARE</span>
                    <span class="btn-arrow">[➔]</span>
                </a>
                <a href="/swagger" target="_blank" class="btn-brutalist" title="Swagger OpenAPI">
                    <span>SWAGGER [↗]</span>
                </a>
            </div>
        </article>
    </section>

    <!-- Brutalist Tech Strip (6 items) -->
    <section class="brutalist-specs-grid">
        <div class="spec-cell">
            <span class="spec-key">RUNTIME</span>
            <span class="spec-val">.NET 10.0</span>
        </div>
        <div class="spec-cell">
            <span class="spec-key">LANGUAGE</span>
            <span class="spec-val">C# 13.0</span>
        </div>
        <div class="spec-cell">
            <span class="spec-key">REALTIME</span>
            <span class="spec-val">SIGNALR</span>
        </div>
        <div class="spec-cell">
            <span class="spec-key">DATABASE</span>
            <span class="spec-val">POSTGRESQL</span>
        </div>
        <div class="spec-cell">
            <span class="spec-key">CACHE / SYNC</span>
            <span class="spec-val">IN-MEMORY</span>
        </div>
        <div class="spec-cell">
            <span class="spec-key">HOSTING</span>
            <span class="spec-val">RAILWAY / DOCKER</span>
        </div>
    </section>
</div>
